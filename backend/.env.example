# ==============================================================================
# Variables de Configuración - CSO Incident Masivas Report
# Copiar este archivo a .env en backend/ para personalizar los valores por entorno.
# ==============================================================================

# Entorno de ejecución (development / production)
ENVIRONMENT=production

# Puerto HTTP en el que escucha FastAPI (por defecto 8000)
BACKEND_PORT=8000

# Base de datos SQLite
# - En desarrollo local: sqlite:///reports.db
# - En servidor /infocodes: sqlite:////infocodes/var/data/cso-incident-masivas-report/reports.db
DATABASE_URL=sqlite:////infocodes/var/data/cso-incident-masivas-report/reports.db

# Directorio de almacenamiento persistente de Informes Ejecutivos PPTX
# (/infocodes/var/storage/executive_pptx compartido con gestion-problemas-dashboard)
EXECUTIVE_REPORTS_OUTPUT_DIR=/infocodes/var/storage/executive_pptx

# Raíz del proyecto hermano release-dashboard-application
RELEASE_DASHBOARD_ROOT=/infocodes/project/release-dashboard-application

# Orígenes permitidos en CORS (separados por coma)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://10.132.68.85:8081,http://infocodes.si.orange.es:8081
