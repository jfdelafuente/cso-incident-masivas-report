# ============================================
# Configuración del Backend FastAPI (cso-incident-masivas-report)
# ============================================

# Puerto donde escucha la API FastAPI (por defecto: 8000)
BACKEND_PORT=8000

# Base de datos SQLite o PostgreSQL para almacenamiento de reportes semanales
# Por defecto: sqlite:///reports.db
DATABASE_URL=sqlite:///reports.db

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080,http://10.132.68.85:8081,http://infocodes.si.orange.es:8081

# Recarga en caliente en desarrollo (true o false)
RELOAD=true

# Ruta al proyecto release-dashboard-application (opcional, calculada automáticamente por defecto)
# RELEASE_DASHBOARD_PATH=../../release-dashboard-application

